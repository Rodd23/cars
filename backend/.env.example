# Copie para .env e preencha. Nunca versione o .env com valores reais.

# development | production | test
NODE_ENV=development
PORT=3333

# Connection string do PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/cars

# Chave e modelo da OpenAI (usados por POST /cars/search; hoje obrigatórios na inicialização)
OPENAI_API_KEY=
OPENAI_MODEL=

# Origens do frontend autorizadas pelo CORS, separadas por vírgula, sem barra final.
# Vazio em development usa http://localhost:5173; obrigatório em production.
CORS_ORIGINS=http://localhost:5173
